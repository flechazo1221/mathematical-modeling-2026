{
  "visual_system": {
    "name": "Modern Academic Blue",
    "purpose": "在不改变任何数据、数值、筛选、聚合、误差定义、科学主张和证据边界的前提下，生成清晰、统一、现代且可直接用于数学建模论文的出版级图表。",
    "precedence": [
      "requirement 中的科学与证据约束（最高优先级，任何视觉规则不得覆盖）",
      "requirement.style_override（仅允许覆盖视觉呈现字段）",
      "chart_style_defaults 中对应图型默认值",
      "visual_system、rendering_contract、annotation_rules、layout_rules、table_style、export_spec 的全局默认值"
    ],
    "style_override_contract": {
      "availability": "每个 requirements[] 项均可选填 style_override 对象；未填时继承全局与图型默认值。",
      "allowed_scope": [
        "palette_role", "line_style", "marker", "line_width_pt", "marker_size_pt",
        "legend", "panel_layout", "aspect_ratio", "axis_scale", "tick_format",
        "grid_visibility", "annotation_placement", "inset", "color_map", "table_column_widths"
      ],
      "forbidden_scope": [
        "requirements", "authoritative_source", "source_fields", "mandatory_limit",
        "question_claim", "reader_question", "数据值", "单位", "筛选规则", "聚合规则",
        "误差定义", "统计口径", "结论方向", "阈值", "报告精度"
      ],
      "validation": "若 style_override 与科学/证据约束冲突，必须忽略该视觉覆盖并报告冲突，不得静默改变数据表达。"
    },
    "background": "#FFFFFF",
    "text_colors": {
      "title": "#17324D",
      "body": "#243746",
      "secondary": "#5B6870",
      "muted": "#7B8790"
    },
    "palette": {
      "primary_blue": "#1F5A94",
      "secondary_blue": "#4C8BBE",
      "light_blue": "#9CC4DF",
      "accent_orange": "#D97932",
      "accent_teal": "#2A8C82",
      "accent_purple": "#7566A8",
      "neutral_dark": "#4C5661",
      "neutral_mid": "#8A949E",
      "neutral_light": "#D9DEE3",
      "grid": "#DCE2E7",
      "confidence_fill_alpha": 0.16,
      "categorical_order": ["#1F5A94", "#D97932", "#2A8C82", "#7566A8", "#7B8790", "#9CC4DF"],
      "rule": "同一变量、模型、工况或证据角色跨所有图保持同色；颜色之外必须辅以线型、marker 或纹理，确保灰度与色觉缺陷环境下仍可区分。禁止用颜色暗示原 requirements 未声明的优劣。"
    },
    "continuous_colormaps": {
      "sequential_default": "cividis",
      "sequential_alternative": "viridis",
      "diverging_default": "RdBu_r",
      "diverging_center": "仅当变量具有有意义的零点/基准点时按该值居中",
      "forbidden": ["jet", "rainbow", "hsv", "spectral_rainbow"]
    }
  },
  "rendering_contract": {
    "workflow": [
      "读取 authoritative_source，并严格核对 source_fields、单位、缺失值、排序和样本量。",
      "逐条执行 requirements；先写一句该图回答的 reader_question，再选择最小必要视觉编码。",
      "按最终论文物理尺寸直接渲染，不允许先画大图再在 Word/LaTeX 中大幅缩小。",
      "先应用全局视觉规范与图型默认值，再应用该 requirement 的 style_override。",
      "生成彩色正式版、灰度预览和最终尺寸预览；逐项执行 quality_gate。",
      "任何质量门失败必须修改绘图源代码并重新渲染，禁止手工改位图。"
    ],
    "data_integrity": {
      "immutable": "现有 requirements 的全部字段和值均为数据与科学语义真值；视觉系统不得修改、推断替代或重新解释。",
      "no_fabrication": "不得补造数据点、平滑掉异常、选择性隐藏失败样本、改变阈值或以视觉插值替代真实计算。",
      "simulation_language": "凡 mandatory_limit 限定为模型场/模拟/条件结果，标题、图注和标注不得写成实测、验证真实准确性或经验拟合。",
      "numeric_fidelity": "标注数字必须从权威源或 requirement 已登记数值程序化读取；显示位数遵循原报告精度，不允许手工重写造成漂移。"
    },
    "implementation": {
      "preferred_backend": "Python matplotlib/seaborn 或等价的可复现矢量绘图后端",
      "theme": "显式设置全部关键样式参数，不调用未经覆盖的默认主题",
      "font_embedding": "PDF 使用 TrueType/Type 42 或等价可嵌入字体；SVG 保留可编辑矢量文字或可靠嵌入字体。",
      "randomness": "若 jitter、抽样或标签避让含随机性，固定随机种子并记录。"
    },
    "caption_contract": "每张图/表的图注必须说明回答的问题、变量与单位、模型/工况、必要的误差或区间定义、样本量/网格数（若适用）、关键限制及 authoritative_source 的可追溯标识。"
  },

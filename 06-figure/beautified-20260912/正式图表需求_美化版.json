  "annotation_rules": {
    "principle": "注释只用于阈值、极值、转折、报告时刻、基准线、异常/失效状态和原 requirement 明确登记的关键数值；不复述坐标轴可直接读出的所有点。",
    "source": "所有数值注释由代码从 authoritative_source 或 requirement 登记值生成，不允许手工凭视觉抄录。",
    "precision": "与原 requirement 的报告精度一致；科学计数法统一；单位只在不会重复拥挤时随值显示。",
    "placement": "使用偏移量和避让算法放在数据空白侧；引线细、短、颜色 #687681；不得跨越多个系列或遮挡数据。",
    "thresholds": "阈值/基准线使用克制的虚线，并直接标注名称与值；不得仅依赖颜色识别。",
    "censored_or_failed": "72 h 未达标等右删失/失败状态用明确文字或专用符号表达，不得把计算上限画成实际达标时刻。",
    "significance": "只有权威结果包含统计检验时才允许显著性标注；必须定义符号、p 值口径、检验与校正。",
    "density_limit": "单面板通常不超过 3 个重点注释；超过时改用编号+图注、局部 inset 或表格。",
    "inset": "仅用于阈值 bracket、局部收敛等确需放大的细节；必须标出母图对应区域并保持刻度、单位和数据一致。"
  },
  "layout_rules": {
    "hierarchy": "主结果占最大视觉面积；机制/对比次之；验证和技术审计更安静。不得因面板数量而机械等分。",
    "panel_labels": {
      "format": "(a), (b), (c) ...",
      "font_weight": 700,
      "color": "#17324D",
      "position": "每个轴框左上外侧，同一基线，统一偏移，不进入数据区。",
      "sequence": "从左到右、从上到下，必须与正文引用顺序一致。"
    },
    "multi_panel": {
      "preferred_columns": "2–3 个面板优先 1×2、1×3 或不对称布局；4 个面板优先 2×2；依证据重要性允许主面板跨列。",
      "alignment": "共享行/列的绘图区边界、轴标签基线、色条和标题基线对齐。",
      "shared_axes": "同变量比较优先共享坐标范围和刻度；非同量纲不得伪共享。",
      "spacing": "面板间距足以容纳标签但不形成拼贴感；推荐 wspace=0.24–0.34、hspace=0.28–0.40，按最终尺寸微调。",
      "shared_legend": "多面板重复系列使用一个共享图例，放在顶部或右侧专用区域。"
    },
    "titles": "图内标题短而结论导向，左对齐；论文已有完整图题时可省略总标题，避免标题重复。深蓝色、不使用全大写。",
    "whitespace": "绘图区周围保留均衡留白；不得用缩小字体、压扁坐标轴或把图例塞入数据区来解决拥挤。",
    "redundancy": "每个面板回答唯一问题；若遮掉面板不削弱论证，应删除、合并或移至附录。视觉美化不得新增装饰面板。"
  },

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "handoff.schema.json",
  "title": "Math Modeling Stage Handoff",
  "type": "object",
  "required": ["schema_version", "stage", "status", "inputs", "outputs", "unknowns", "warnings", "required_next_actions"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "stage": {"enum": ["SELECTION", "INTAKE", "LITERATURE", "DESIGN", "PROTOTYPE", "COMPUTE", "EVIDENCE", "FIGURE", "PAPER", "AUDIT"]},
    "status": {"enum": ["PASS", "FAIL", "BLOCKED"]},
    "inputs": {"type": "array", "items": {"$ref": "#/$defs/file"}, "uniqueItems": true},
    "outputs": {"type": "array", "items": {"$ref": "#/$defs/file"}, "uniqueItems": true},
    "frozen_decisions": {"type": "array", "items": {"$ref": "#/$defs/file"}, "uniqueItems": true},
    "assumptions": {"type": "array", "items": {"type": "string"}},
    "unknowns": {"type": "array", "items": {"type": "string"}},
    "claims": {"type": "array", "items": {"type": "string"}},
    "evidence": {"type": "array", "items": {"type": "string"}},
    "warnings": {"type": "array", "items": {"type": "string"}},
    "required_next_actions": {"type": "array", "items": {"type": "string"}},
    "completed_at": {"type": ["string", "null"], "format": "date-time"}
  },
  "$defs": {
    "file": {
      "type": "object",
      "required": ["path", "sha256"],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?![A-Za-z]:)(?![/\\\\])(?!.*(?:^|[/\\\\])\\.\\.(?:[/\\\\]|$)).+$"
        },
        "sha256": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"}
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "PASS"}}, "required": ["status"]},
      "then": {
        "required": ["completed_at"],
        "properties": {
          "outputs": {"minItems": 1},
          "completed_at": {"type": "string", "format": "date-time"}
        }
      }
    },
    {
      "if": {"properties": {"status": {"enum": ["FAIL", "BLOCKED"]}}, "required": ["status"]},
      "then": {"properties": {"required_next_actions": {"minItems": 1}}}
    }
  ],
  "additionalProperties": false
}

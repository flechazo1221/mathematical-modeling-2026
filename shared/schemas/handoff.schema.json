{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "handoff.schema.json",
  "title": "Math Modeling Stage Handoff",
  "type": "object",
  "required": ["schema_version", "stage", "status", "inputs", "outputs", "unknowns", "warnings", "required_next_actions"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "stage": {"enum": ["SELECTION", "INTAKE", "DESIGN", "PROTOTYPE", "COMPUTE", "EVIDENCE", "FIGURE", "PAPER", "AUDIT"]},
    "status": {"enum": ["PASS", "FAIL", "BLOCKED"]},
    "inputs": {"type": "array", "items": {"$ref": "#/$defs/file"}},
    "outputs": {"type": "array", "items": {"$ref": "#/$defs/file"}},
    "frozen_decisions": {"type": "array", "items": {"$ref": "#/$defs/file"}},
    "assumptions": {"type": "array", "items": {"type": "string"}},
    "unknowns": {"type": "array", "items": {"type": "string"}},
    "claims": {"type": "array", "items": {"type": "string"}},
    "evidence": {"type": "array", "items": {"type": "string"}},
    "warnings": {"type": "array", "items": {"type": "string"}},
    "required_next_actions": {"type": "array", "items": {"type": "string"}},
    "completed_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "file": {
      "type": "object",
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": true
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "selection-score.schema.json",
  "title": "Problem Selection Scorecard",
  "type": "object",
  "required": ["schema_version", "criteria_weights", "score_scale", "candidates", "ranking"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "criteria_weights": {
      "type": "object",
      "required": ["problem_understanding", "data_processability", "result_verifiability", "model_feasibility", "ai_reliability"],
      "properties": {
        "problem_understanding": {"const": 0.25},
        "data_processability": {"const": 0.15},
        "result_verifiability": {"const": 0.20},
        "model_feasibility": {"const": 0.15},
        "ai_reliability": {"const": 0.25}
      },
      "additionalProperties": false
    },
    "score_scale": {
      "type": "object",
      "required": ["min", "max", "higher_is_better"],
      "properties": {
        "min": {"const": 0},
        "max": {"const": 10},
        "higher_is_better": {"const": true}
      },
      "additionalProperties": false
    },
    "candidates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "title", "criteria", "weighted_total", "hard_stops", "unknowns"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "title": {"type": "string", "minLength": 1},
          "criteria": {
            "type": "object",
            "required": ["problem_understanding", "data_processability", "result_verifiability", "model_feasibility", "ai_reliability"],
            "properties": {
              "problem_understanding": {"$ref": "#/$defs/criterion"},
              "data_processability": {"$ref": "#/$defs/criterion"},
              "result_verifiability": {"$ref": "#/$defs/criterion"},
              "model_feasibility": {"$ref": "#/$defs/criterion"},
              "ai_reliability": {"$ref": "#/$defs/criterion"}
            },
            "additionalProperties": false
          },
          "weighted_total": {"type": "number", "minimum": 0, "maximum": 100},
          "hard_stops": {"type": "array", "items": {"type": "string"}},
          "unknowns": {"type": "array", "items": {"type": "string"}}
        },
        "additionalProperties": true
      }
    },
    "ranking": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
    "method_note": {"type": "string"}
  },
  "$defs": {
    "criterion": {
      "type": "object",
      "required": ["score", "confidence", "evidence", "risks"],
      "properties": {
        "score": {"type": "number", "minimum": 0, "maximum": 10},
        "confidence": {"enum": ["HIGH", "MEDIUM", "LOW"]},
        "evidence": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "risks": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}

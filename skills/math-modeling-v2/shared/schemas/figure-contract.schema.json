{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "figure-contract.schema.json",
  "title": "Publication Figure Contract",
  "type": "object",
  "required": ["figure_id", "claim_ids", "question", "source_files", "required_comparisons", "target_formats"],
  "properties": {
    "figure_id": {"type": "string", "minLength": 1},
    "claim_ids": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "question": {"type": "string", "minLength": 1},
    "source_files": {"type": "array", "items": {"$ref": "handoff.schema.json#/$defs/file"}, "minItems": 1},
    "x": {"type": ["object", "null"]},
    "y": {"type": ["object", "null"]},
    "groups": {"type": "array", "items": {"type": "string"}},
    "uncertainty": {"type": ["string", "null"]},
    "required_comparisons": {"type": "array", "items": {"type": "string"}},
    "must_show_failures": {"type": "boolean"},
    "prohibited_operations": {"type": "array", "items": {"type": "string"}},
    "target_formats": {"type": "array", "items": {"enum": ["svg", "png", "pdf"]}, "uniqueItems": true},
    "minimum_dpi": {"type": "integer", "minimum": 72}
  },
  "additionalProperties": true
}
